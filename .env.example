# ==============================================================================
# THPTQG 2026 Vật Lý Studio — Biến môi trường phía Server (Tùy chọn)
# ==============================================================================
# Nếu bạn đặt API key tại đây (hoặc trên Vercel / Netlify Environment Variables),
# người dùng truy cập website có thể tạo đề ngay mà KHÔNG cần tự nhập API key
# và key được bảo mật hoàn toàn trên server.
# Nếu để trống, người dùng vẫn có thể tự nhập API key miễn phí trong mục Cài đặt AI.

# 1. Google AI Studio (Khuyên dùng — Miễn phí tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2. GroqCloud (Siêu tốc — Miễn phí tại https://console.groq.com/keys)
GROQ_API_KEY=

# 3. OpenRouter (Đa model miễn phí — https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 4. Endpoint tương thích OpenAI tùy chỉnh (tùy chọn: Cerebras, Mistral, Ollama...)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Tùy chọn nhà cung cấp & model mặc định khi chạy Server Proxy
# DEFAULT_AI_PROVIDER: gemini | groq | openrouter | custom
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-3.5-flash-lite

# Cổng chạy local với `npm start`
PORT=3000
